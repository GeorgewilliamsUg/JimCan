# ==============================================================================
# Jimcan Operations Dashboard - Production Environment Configuration
# Copy this file to .env on your cPanel server (/home/username/jimcan/.env)
# ==============================================================================

# Security
SECRET_KEY=generate-a-strong-random-50-character-string-here
AUDIT_HMAC_KEY=generate-a-separate-strong-random-50-character-string-here
DEBUG=False
ALLOWED_HOSTS=jimcanconstruction.site,www.jimcanconstruction.site
CSRF_TRUSTED_ORIGINS=https://jimcanconstruction.site,https://www.jimcanconstruction.site

# Database (Leave blank to use default SQLite, or fill for cPanel MySQL)
# To use MySQL:
# 1. Create a database in cPanel -> MySQL Databases (e.g. cpaneluser_jimcandb)
# 2. Create a user (e.g. cpaneluser_jimcanuser) and grant ALL PRIVILEGES
# 3. Enter those values here:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email Settings (for Password Reset & Notifications via Namecheap Webmail/cPanel)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=Jimcan Operations <notifications@yourdomain.com>

# MFA Staged Rollout & Time Drift Settings
# MFA_ENFORCEMENT: 'off' (optional), 'owners' (Owner group only), 'all' (mandatory universal)
MFA_ENFORCEMENT=all
# OTP_TOTP_TOLERANCE: number of 30s steps to allow before/after (default 2 = +/- 60s, recommended for shared hosting)
OTP_TOTP_TOLERANCE=2
